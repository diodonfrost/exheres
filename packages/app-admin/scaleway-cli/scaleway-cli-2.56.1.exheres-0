require go [ go_minimum_version=1.26.0 bin_name=scw package_path=./cmd/scw ] github [ user=scaleway tag=v${PV} ]

SUMMARY="Command Line Interface for Scaleway"
HOMEPAGE="https://www.scaleway.com"

LICENCES="Apache-2.0"
SLOT="0"
PLATFORMS="~amd64 ~armv8"
MYOPTIONS=""

DEPENDENCIES=""

GO_SRC_COMPILE_LDFLAGS=(
    "-s"
    "-w"
    "-X main.Version=${PV}"
)
