require cargo [ rust_minimum_version=1.92.0 ] github [ tag=v${PV} ]

SUMMARY="Lightweight, high-performance web browser engine written in Rust"
HOMEPAGE="https://servo.org"

LICENCES="MPL-2.0"
SLOT="0"
PLATFORMS="~amd64 ~armv8"
MYOPTIONS=""

DEPENDENCIES="
    build:
        sys-devel/cmake
        dev-util/gperf
        dev-lang/clang
        virtual/pkg-config
    build+run:
        dev-libs/glib:2
        dev-libs/openssl
        media-libs/fontconfig
        media-libs/freetype:2
        media-libs/gstreamer:1.0
        media-plugins/gst-plugins-base:1.0
        media-plugins/gst-plugins-good:1.0
        media-plugins/gst-plugins-bad:1.0
        x11-libs/harfbuzz
        x11-dri/mesa
        sys-libs/vulkan-loader
        sys-apps/dbus
        dev-libs/libunwind
        sys-apps/systemd
        x11-libs/libX11
        x11-libs/libXcursor
        x11-libs/libXi
        x11-libs/libXrandr
        x11-libs/libxcb
        x11-libs/libxkbcommon
"

src_prepare() {
    default

    # glsl-optimizer (vendored in glslopt 0.1.12) redefines once_flag/call_once
    # in c11/threads_posix.h. glibc 2.28+ provides both in <bits/types/once_flag.h>
    # (pulled in by <stdlib.h>), causing duplicate-typedef errors when stdlib.h
    # is included first. Guard glsl-optimizer's definitions on glibc's
    # __once_flag_defined so glibc's win in that case.
    local glslopt_dir="${WORKBASE}/ecargo-vendor/glslopt"
    edo sed -i -z \
        -e 's|typedef pthread_once_t  once_flag;|#ifndef __once_flag_defined\n#define __once_flag_defined 1\n&\n#endif|' \
        -e 's|// 7\.25\.2\.1\nstatic inline void\ncall_once(once_flag \*flag, void (\*func)(void))\n{\n    pthread_once(flag, func);\n}|#ifndef __once_flag_defined\n&\n#endif|' \
        "${glslopt_dir}/glsl-optimizer/include/c11/threads_posix.h"
    edo sed -i 's/"files":{[^}]*}/"files":{}/' "${glslopt_dir}/.cargo-checksum.json"

    # zbus-lockstep-macros 0.5.1's `validate` proc macro panics with
    # `expect("File has no extension.")` when iterating an XML directory that
    # contains entries without a `.xml` suffix. atspi-common's xml/ ships a
    # python helper and a schemas/ subdir alongside its D-Bus XMLs. Make the
    # extension check tolerant of None so non-XML entries are skipped.
    local zbus_macros_dir="${WORKBASE}/ecargo-vendor/zbus-lockstep-macros"
    edo sed -i 's#entry\.path()\.extension()\.expect("File has no extension\.") == "xml"#entry.path().extension().is_some_and(|e| e == "xml")#' \
        "${zbus_macros_dir}/src/lib.rs"
    edo sed -i 's/"files":{[^}]*}/"files":{}/' "${zbus_macros_dir}/.cargo-checksum.json"
}

src_compile() {
    esandbox disable_net

    # Remove cargo exlib config that replaces crates-io with a local directory,
    # servo needs to fetch crates and git deps at build time
    edo rm -f "${ECARGO_HOME}/config.toml"

    # zbus-lockstep-macros' validate macro auto-resolves the XML directory by
    # walking parents (current_dir/xml, then ../xml, etc., later entries win).
    # In servo's vendor tree the `xml` crate sits at ecargo-vendor/xml/ — the
    # `../xml` candidate from atspi-common — and overrides atspi-common's own
    # xml/ with Rust source, breaking signal lookup. Pin the path explicitly
    # via the env var the macro honors as the highest-priority override.
    export LOCKSTEP_XML_PATH="${WORKBASE}/ecargo-vendor/atspi-common/xml"

    edo cargo build --release -p servoshell
}

src_install() {
    local target_dir
    target_dir=$(find target -path '*/release/servoshell' -type f | head -1 | xargs dirname)

    local libdir="/usr/$(exhost --target)/lib/servo"

    exeinto "${libdir}"
    newexe "${target_dir}/servoshell" servo

    insinto "${libdir}/resources"
    doins resources/*

    dodir /usr/$(exhost --target)/bin
    dosym "${libdir}/servo" /usr/$(exhost --target)/bin/servo

    insinto /usr/share/icons/hicolor/scalable/apps
    newins resources/servo.svg servo.svg

    insinto /usr/share/icons/hicolor/64x64/apps
    newins resources/servo_64.png servo.png

    insinto /usr/share/icons/hicolor/1024x1024/apps
    newins resources/servo_1024.png servo.png

    insinto /usr/share/applications
    hereins servo.desktop <<EOF
[Desktop Entry]
Type=Application
Name=Servo
Exec=servo
Icon=servo
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
EOF
}
